@model ShoppingCartViewModel

<h2 class="my-4" style="color: #D89FAF;">
    🛍️ Mi Carrito de Compras
</h2>

@if (Model.ShoppingCart.ShoppingCartItems.Count == 0)
{
    <div class="alert alert-info text-center py-4">
        <h4>Tu carrito está vacío</h4>
        <p class="mt-3">
            <a asp-controller="Product" asp-action="List" class="btn btn-primary">
                Ir a ver nuestras joyas
            </a>
        </p>
    </div>
}
else
{
    <div class="row">
        <!-- Lista de productos -->
        <div class="col-md-8">
            @foreach (var item in Model.ShoppingCart.ShoppingCartItems)
            {
                <div class="card mb-3">
                    <div class="row g-0">
                        <div class="col-md-3">
                            <!-- CORREGIDO: Usamos ImageUrl porque es la que tienes llena -->
                            <img src="@item.Product.ImageUrl" 
                                 class="img-fluid rounded-start" 
                                 alt="@item.Product.Name"
                                 style="height: 140px; object-fit: cover;">
                        </div>
                        <div class="col-md-9">
                            <div class="card-body">
                                <h5 class="card-title">@item.Product.Name</h5>
                                <p class="text-muted">Cantidad: @item.Amount</p>
                                <p class="price fw-bold">
                                    Bs @((item.Product.Price * item.Amount).ToString("N2"))
                                </p>

                                <a asp-controller="ShoppingCart" 
                                   asp-action="RemoveFromCart" 
                                   asp-route-productId="@item.Product.ProductId"
                                   class="btn btn-sm btn-outline-danger">
                                    Eliminar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Resumen del total -->
        <div class="col-md-4">
            <div class="card sticky-top" style="top: 90px;">
                <div class="card-body">
                    <h4 class="mb-3">Resumen del pedido</h4>
                    <h5>Total a pagar: 
                        <span class="price" style="color: #D4AF37; font-size: 1.4rem;">
                            Bs @Model.ShoppingCartTotal.ToString("N2")
                        </span>
                    </h5>
                    
                    <a href="#" class="btn btn-success w-100 mt-4 py-3 fs-5">
                        Proceder al pago
                    </a>
                    
                    <a asp-controller="Product" asp-action="List" 
                       class="btn btn-outline-secondary w-100 mt-2">
                        Seguir comprando
                    </a>
                </div>
            </div>
        </div>
    </div>
}