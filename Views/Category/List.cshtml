@using web_05.ViewModels
@model CategoryListViewModel

@{
    ViewData["Title"] = Model.Title;   // Opcional: lo pone en la pestaña del navegador
}

<h1>@Model.Title</h1>

<p>Mostrando <strong>@Model.TotalCategories</strong> categorías disponibles</p>

@if (!Model.Categories.Any())
{
    <p class="text-muted">No hay categorías registradas todavía.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Cantidad de productos</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model.Categories)
            {
                <tr>
                    <td>@category.CategoryName</td>
                    <td>@(category.Description ?? "Sin descripción")</td>
                    <td>@(category.Products?.Count ?? 0)</td>
                    <td>
                        <a asp-controller="Product" 
                           asp-action="List" 
                           asp-route-category="@category.CategoryName"
                           class="btn btn-sm btn-primary">
                            Ver Productos
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Opcional: enlace para volver -->
<p>
    <a asp-controller="Product" asp-action="List" class="btn btn-outline-secondary">ALIZON LA MEJOR 💅✨</a>
</p>