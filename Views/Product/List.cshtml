@using web_05.ViewModels
@model ProductListViewModel

<h1 class="mb-4">@Model.CurrentCategory</h1>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var product in Model.Products)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <!-- Usamos ImageUrl porque es la que tienes llena -->
                <img src="@product.ImageUrl" 
                     class="card-img-top" 
                     alt="@product.Name" 
                     style="height: 260px; object-fit: cover;">

                <div class="card-body d-flex flex-column text-center">
                    <h5 class="card-title fw-bold">
                        <a asp-controller="Product" 
                           asp-action="Details" 
                           asp-route-id="@product.ProductId" 
                           class="text-decoration-none">@product.Name</a>
                    </h5>
                    
                    <p class="card-text text-muted fs-5 fw-semibold mb-3">
                        @product.Price.ToString("c")
                    </p>

                    <div class="mt-auto">
                        <!-- Botón Añadir al carrito -->
                        <a asp-controller="ShoppingCart" 
                           asp-action="AddToCart" 
                           asp-route-productId="@product.ProductId"
                           class="btn btn-primary w-100 mb-2"
                           style="background-color: #D89FAF; border-color: #D89FAF; color: white;">
                             Añadir al carrito
                        </a>

                        <!-- Botón Ver detalles -->
                        <a asp-controller="Product" 
                           asp-action="Details" 
                           asp-route-id="@product.ProductId" 
                           class="btn btn-outline-secondary w-100">
                            Ver detalles
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>