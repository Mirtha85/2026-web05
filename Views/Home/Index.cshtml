@model HomeViewModel

<!-- Carousel elegante -->
<div id="mainCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
        <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="2"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/Images/carousel1.jpeg" class="d-block w-100" alt="Joyas exclusivas" style="height: 520px; object-fit: cover;">
            <div class="carousel-caption d-none d-md-block">
                <h2 class="display-4 fw-bold">NAVO RI</h2>
                <p class="lead">Elegancia que perdura</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/Images/carousel2.jpeg" class="d-block w-100" alt="Colección 2025" style="height: 520px; object-fit: cover;">
        </div>
        <div class="carousel-item">
            <img src="~/Images/carousel3.jpeg" class="d-block w-100" alt="Brillo eterno" style="height: 520px; object-fit: cover;">
        </div>
    </div>
</div>

<!-- Joyas destacadas -->
<div class="container my-5">
    <h2 class="text-center mb-5" style="color: #D89FAF;">Joyas Destacadas</h2>
    
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var product in Model.FeaturedProducts)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <img src="@product.ImageUrl" 
                         class="card-img-top" 
                         alt="@product.Name"
                         style="height: 260px; object-fit: cover;">
                    <div class="card-body text-center">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="price fs-4">@product.Price.ToString("C")</p>
                        <a asp-controller="Product" 
                           asp-action="Details" 
                           asp-route-id="@product.ProductId" 
                           class="btn btn-outline-primary mt-2">Ver detalles</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>